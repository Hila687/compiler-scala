class H {

    function void draw(int x, int y, int size, int rotation) {
        // Pixel-art heart.
        // rotation: 0,1,2,3 represents 0,90,180,270 degrees.

        do H.cell(x, y, size, 1, 0, rotation);
        do H.cell(x, y, size, 2, 0, rotation);
        do H.cell(x, y, size, 4, 0, rotation);
        do H.cell(x, y, size, 5, 0, rotation);

        do H.cell(x, y, size, 0, 1, rotation);
        do H.cell(x, y, size, 1, 1, rotation);
        do H.cell(x, y, size, 2, 1, rotation);
        do H.cell(x, y, size, 3, 1, rotation);
        do H.cell(x, y, size, 4, 1, rotation);
        do H.cell(x, y, size, 5, 1, rotation);
        do H.cell(x, y, size, 6, 1, rotation);

        do H.cell(x, y, size, 0, 2, rotation);
        do H.cell(x, y, size, 1, 2, rotation);
        do H.cell(x, y, size, 2, 2, rotation);
        do H.cell(x, y, size, 3, 2, rotation);
        do H.cell(x, y, size, 4, 2, rotation);
        do H.cell(x, y, size, 5, 2, rotation);
        do H.cell(x, y, size, 6, 2, rotation);

        do H.cell(x, y, size, 1, 3, rotation);
        do H.cell(x, y, size, 2, 3, rotation);
        do H.cell(x, y, size, 3, 3, rotation);
        do H.cell(x, y, size, 4, 3, rotation);
        do H.cell(x, y, size, 5, 3, rotation);

        do H.cell(x, y, size, 2, 4, rotation);
        do H.cell(x, y, size, 3, 4, rotation);
        do H.cell(x, y, size, 4, 4, rotation);

        do H.cell(x, y, size, 3, 5, rotation);

        return;
    }

    function void cell(int x, int y, int size, int c, int r, int rotation) {
        var int block, nc, nr, x1, y1;

        let block = size * 8;

        if (rotation = 0) {
            let nc = c;
            let nr = r;
        }

        if (rotation = 1) {
            let nc = 5 - r;
            let nr = c;
        }

        if (rotation = 2) {
            let nc = 6 - c;
            let nr = 5 - r;
        }

        if (rotation = 3) {
            let nc = r;
            let nr = 6 - c;
        }

        let x1 = x + (nc * block);
        let y1 = y + (nr * block);

        do Screen.drawRectangle(x1, y1, x1 + block, y1 + block);

        return;
    }
}